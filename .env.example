# Deployment mode: "cloud" or "self-hosted" (default).
# Cloud: hides update banner, enables operator-only features. Self-hosted: opposite.
DEPLOYMENT_MODE=self-hosted

# Brand identity (used in UI, emails, service names, container names)
BUSINESS_NAME=
BUSINESS_SLUG=
VITE_BUSINESS_NAME=
VITE_BUSINESS_SLUG=

# Database Configuration
POSTGRES_USER=buching
POSTGRES_PASSWORD=buching_password
POSTGRES_DB=buching
DATABASE_URL=postgresql://buching:buching_password@localhost:5433/buching

# Application Ports + URLs
SERVER_PORT=3456
WEB_PORT=5678
# Canonical web origin (used by server for CORS, email links, OAuth callbacks).
WEB_URL=http://localhost:5678
# Web → server base URL (browser fetches use this).
VITE_SERVER_URL=http://localhost:3456
# The main public site origin (e.g. https://buchingmate.com). Hosts the global
# /events feed, attendee /me, and admin. Used in emails + share links.
VITE_PUBLIC_SITE_URL=http://lvh.me:5678
# Extra main-domain hosts allowed by CORS. Comma-separated suffixes; a leading
# dot matches any subdomain (.example.com → foo.example.com). Customer custom
# domains are NOT listed here — they're allowed dynamically from the database.
PUBLIC_HOST_ALLOWLIST=.lvh.me,.localhost,localhost

# Custom booking domains (Cloudflare for SaaS). Leave empty in local dev:
# domains added in org settings then activate immediately without TLS
# provisioning so any lvh.me host can simulate a customer domain.
# API token needs Zone → SSL and Certificates → Edit on the zone below.
CLOUDFLARE_API_TOKEN=
# Zone hosting the platform (e.g. buchingmate.com).
CLOUDFLARE_ZONE_ID=
# Hostname customers CNAME to (the SaaS zone's fallback origin record),
# e.g. domains.buchingmate.com.
CF_SAAS_CNAME_TARGET=

# Better Auth
# Session-cookie signing secret. Generate: openssl rand -base64 32
# Rotating this invalidates all sessions. Required in prod.
BETTER_AUTH_SECRET=your-secret-key-here
# Server base URL better-auth uses for callback construction. Match WEB_URL host
# if reverse-proxied, else server origin.
BETTER_AUTH_URL=http://localhost:3456

# Staff sign-in/up email domain allowlist. Comma-separated. Empty = unrestricted.
# Staging: set to buchingmate.com to gate access.
ALLOWED_EMAIL_DOMAINS=
VITE_ALLOWED_EMAIL_DOMAINS=

# Cloudflare Turnstile (CAPTCHA on signup/login/forget-password).
# Get keys at https://dash.cloudflare.com → Turnstile.
# Leave blank to disable the captcha plugin (dev convenience).
# Public test keys (always pass): site=1x00000000000000000000AA, secret=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Google OAuth (staff sign-in with Google)
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth client.
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit (local mail catcher for dev/e2e — `docker compose up mailpit`)
# When set, ALL emails go to Mailpit instead of Resend, even with a Resend key
# configured. Inbox UI + REST API at this URL. Leave unset in prod.
MAILPIT_URL=

# Resend (transactional email)
# API key from resend.com → API Keys. RESEND_FROM_EMAIL must be on a verified
# domain (SPF + DKIM + DMARC configured). Empty API key disables sends (logs only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Resend webhook signing secret. Get from Resend dashboard → Webhooks → Add
# endpoint, subscribe to email.sent / email.bounced / email.complained /
# email.delivery_delayed pointing at https://<host>/api/webhooks/resend.
# Empty disables the webhook endpoint (returns 503).
RESEND_WEBHOOK_SECRET=

# Polar (Cloud / EE only — leave unset for self-host)
# When POLAR_ACCESS_TOKEN is set, the Polar plugin loads and billing UI activates.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
POLAR_PRODUCT_TEAM=
# Broadcast capacity add-ons: JSON map of Polar product id -> tier slug. Produced
# by `bun run apps/server/scripts/polar-tiers-setup.ts`. Leave unset to disable.
# Example: {"prod_abc":"broadcasts-10k","prod_def":"broadcasts-25k"}
POLAR_BROADCAST_TIERS=
VITE_BILLING_ENABLED=false

# Observability
# Pino log level: trace|debug|info|warn|error|fatal. Empty defaults to info.
LOG_LEVEL=
# OpenTelemetry service name reported to the collector.
OTEL_SERVICE_NAME=
# OTLP/HTTP collector endpoint (e.g. https://otel.example.com:4318).
# Empty disables telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated header pairs for the OTLP exporter (auth, tenant id).
# Example: authorization=Bearer xyz,x-tenant=acme
OTEL_EXPORTER_OTLP_HEADERS=

# Payments
# Generate via: bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_ENCRYPTION_KEY=

# Stripe Connect (set all 3 or none)
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
# Platform fee percent applied to event ticket payments via Stripe Connect (0 to disable)
STRIPE_PLATFORM_FEE_PERCENT=1

# Cloudflare R2 (public assets: event cover images, org logos)
# Create bucket + API token at dash.cloudflare.com → R2.
# R2_PUBLIC_BASE_URL = bucket's public dev URL or custom domain (no trailing slash).
# Leaving any blank disables uploads (UI hides image picker).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Zoom (User-managed OAuth app — marketplace.zoom.us)
# Create a "User-managed" OAuth app. Scopes: meeting:write:meeting, user:read.
# Redirect URI must match exactly in Zoom dashboard.
# Webhook secret token from Zoom app's Feature → Event Subscriptions.
# Empty client id disables Zoom integration (UI hides connect button).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3456/api/video/callback/zoom
ZOOM_WEBHOOK_SECRET_TOKEN=

# Google Places (server-side autocomplete for event location). Enable the
# "Places API (New)" in Google Cloud and restrict the key to it.
GOOGLE_MAPS_API_KEY=
