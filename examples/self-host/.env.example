# Buching Mate — self-host environment.
# Copy this file to .env and fill in values before running `docker compose up -d`.

# Image version — pin to a specific release tag (e.g. v1.0.0) or use `latest`.
APP_VERSION=latest

# Brand identity (shown in UI, emails)
BUSINESS_NAME=My Booking Service
BUSINESS_SLUG=my-booking

# Database
POSTGRES_USER=buching
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=buching

# Ports (host-side)
SERVER_PORT=3456
WEB_PORT=5678

# Public URLs — change to your real domain when behind a reverse proxy.
WEB_URL=http://localhost:5678
BETTER_AUTH_URL=http://localhost:3456
VITE_SERVER_URL=http://localhost:3456

# Host allowlist for CORS / multi-tenant subdomain parsing.
# Local dev: leave default. Behind a domain: e.g. `.your-domain.com`
PUBLIC_HOST_ALLOWLIST=.localhost,localhost
PLATFORM_HOST_SUFFIXES=.localhost,localhost
TRUSTED_ORIGINS=http://localhost:5678

# Cookie domain — only set when serving across multiple subdomains over HTTPS.
# Example: `.your-domain.com` so cookies span web + tenant subdomains.
# Leave blank for single-host localhost or single-domain setups.
COOKIE_DOMAIN=

# Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
