{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buching-mate-web",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  // Production env (default). All values public — no secrets.
  // Server-side secrets (BETTER_AUTH_SECRET, STRIPE_*, RESEND_*, etc.) live on Coolify.
  "vars": {
    "VITE_SERVER_URL": "https://api.buchingmate.com",
    "VITE_PUBLIC_SITE_URL": "https://buchingmate.com",
    "VITE_BUSINESS_NAME": "BuchingMate",
    "VITE_BUSINESS_SLUG": "buching-mate",
    "VITE_BILLING_ENABLED": "true",
    "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAADYkHpYirYipYkZJ",
    "VITE_ALLOWED_EMAIL_DOMAINS": "buchingmate.com",
  },
  "env": {
    "staging": {
      "name": "buching-mate-staging-web",
      "vars": {
        "VITE_SERVER_URL": "https://api.staging.buchingmate.com",
        "VITE_PUBLIC_SITE_URL": "https://staging.buchingmate.com",
        "VITE_BUSINESS_NAME": "BuchingMate (staging)",
        "VITE_BUSINESS_SLUG": "buching-mate",
        "VITE_BILLING_ENABLED": "true",
        // TODO: fill from Cloudflare → Turnstile (staging widget, whitelist staging.buchingmate.com + *.staging.buchingmate.com)
        "VITE_TURNSTILE_SITE_KEY": "",
        // Staging gate: only @buchingmate.com staff can sign up.
        "VITE_ALLOWED_EMAIL_DOMAINS": "buchingmate.com",
      },
    },
  },
}
