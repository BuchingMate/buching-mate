{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booking-mate-web",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  // NOTE: booking-mate-web is the STAGING worker (despite the name).
  // VITE_* vars are baked into client JS at build time — wrangler `vars` only
  // sets the SSR-side process.env. Keep them in sync with the build env below.
  // Prod worker will be a separate CF service (TBD).
  "vars": {
    "VITE_SERVER_URL": "https://api.staging.buchingmate.com",
    "VITE_PUBLIC_SITE_URL": "https://staging.buchingmate.com",
    "VITE_BUSINESS_NAME": "BuchingMate (staging)",
    "VITE_BUSINESS_SLUG": "buching-mate",
    "VITE_BILLING_ENABLED": "true",
    "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAADYkHpYirYipYkZJ",
    "VITE_ALLOWED_EMAIL_DOMAINS": "buchingmate.com",
  },
}
