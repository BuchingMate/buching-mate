{
  "name": "booking-mate",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "turbo build",
    "dev": "bun run db:up && turbo dev",
    "dev:apps": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "bun run --filter server db:migrate"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.9.16",
    "typescript": "5.9.3",
    "web": "workspace:*",
    "wrangler": "^4.97.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/*"
  ]
}
